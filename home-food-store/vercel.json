{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "server/index.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/menu", "dest": "/products_page.html" },
    { "src": "/products", "dest": "/products_page.html" },
    { "src": "/gallery", "dest": "/gallery.html" },
    { "src": "/services", "dest": "/services.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    { "source": "/(.*)\\.(css|js|svg|png|jpg|jpeg|webp|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
